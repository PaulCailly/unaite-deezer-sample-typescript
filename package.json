{
  "name": "unaite-deezer-sample-typescript",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "sdk:install": "node scripts/install-sdk.mjs",
    "test:playground": "node --test tests/playground.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.20.5"
  }
}
